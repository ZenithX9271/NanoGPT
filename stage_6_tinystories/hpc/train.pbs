#!/bin/bash
#PBS -N nanogpt_s6a
#PBS -P biometric-security.spons
#PBS -q standard
#PBS -l select=1:ncpus=4:ngpus=1:mem=20gb:centos=skylake
#PBS -l walltime=04:00:00
#PBS -l software=PYTHON
#PBS -j oe

# Submit FROM ~/zenithX9271/NanoGPT. Skylake + ngpus=1 is the tested V100 selector.
# PBS keeps its default job-id-specific bootstrap output. Full log also goes to hpc/logs/.
set -euo pipefail
STAGE6_JOB_START_EPOCH=$(date +%s)
cd "${STAGE6_PROJECT_DIR:-${PBS_O_WORKDIR:?Submit from the repository root}}"
if [[ ! -f stage_6_tinystories/configs/continue.json ]]; then
    echo "ERROR: Submit from the NanoGPT repository root (Stage 6 configuration missing)." >&2
    exit 2
fi
mkdir -p stage_6_tinystories/hpc/logs
exec > >(tee -a "stage_6_tinystories/hpc/logs/${PBS_JOBID}.log") 2>&1

module purge
module load apps/pytorch/1.10.0/gpu/intelpython3.7
hash -r
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4
export CUBLAS_WORKSPACE_CONFIG=:4096:8
echo "Job ${PBS_JOBID}; node $(hostname); start $(date)"
command -v python
python --version
python -c "import torch,numpy; print('torch',torch.__version__,'numpy',numpy.__version__,'CUDA',torch.version.cuda); assert torch.cuda.is_available(), 'CUDA unavailable'; gpu=torch.cuda.get_device_name(0); print(gpu); assert 'V100' in gpu, 'This PBS script requires the allocated V100'"
# No separate validation job: fail early on incomplete transfer before training.
python -B stage_6_tinystories/tools/verify_transfer.py --quick

STAGE6_MODE=${STAGE6_MODE:-train}
STAGE6_RUN_NAME=${STAGE6_RUN_NAME:-s6a}
if [[ ! "$STAGE6_RUN_NAME" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "Use a simple run name (letters, numbers, hyphens, underscores)."; exit 2
fi
STAGE6_RUN_DIR="stage_6_tinystories/runs/${STAGE6_RUN_NAME}"
STAGE6_CONFIG=${STAGE6_CONFIG:-stage_6_tinystories/configs/continue.json}
if [[ "$STAGE6_MODE" == restart_check ]]; then
    python -u stage_6_tinystories/tests/check_restart.py \
        --config "$STAGE6_CONFIG" --run-dir "$STAGE6_RUN_DIR" --device cuda --cpu-threads 4 \
        --baseline "${STAGE6_INITIAL_CHECKPOINT:-stage_6_tinystories/baseline/stage5_best.pt}" \
        --walltime-seconds 14400 --job-start-epoch "$STAGE6_JOB_START_EPOCH"
elif [[ "$STAGE6_MODE" == evaluate ]]; then
    python -u stage_6_tinystories/evaluate.py \
        --checkpoint "${STAGE6_CHECKPOINT:?Set STAGE6_CHECKPOINT for evaluation}" \
        --config "$STAGE6_CONFIG" --output-dir "$STAGE6_RUN_DIR" --device cuda --cpu-threads 4 \
        --walltime-seconds 14400 --job-start-epoch "$STAGE6_JOB_START_EPOCH"
else
    if [[ "$STAGE6_MODE" != train && "$STAGE6_MODE" != benchmark && "$STAGE6_MODE" != preflight ]]; then
        echo "Invalid STAGE6_MODE"; exit 2
    fi
    args=(--mode "$STAGE6_MODE" --config "$STAGE6_CONFIG" --run-dir "$STAGE6_RUN_DIR" --device cuda --cpu-threads 4
          --walltime-seconds 14400 --job-start-epoch "$STAGE6_JOB_START_EPOCH")
    if [[ "$STAGE6_MODE" == train ]]; then
        STAGE6_RESUME=${STAGE6_RESUME:-${STAGE6_RUN_DIR}/latest.pt}
        if [[ ! -f "$STAGE6_RESUME" ]]; then
            echo "ERROR: Stage 6 resume checkpoint not found: $STAGE6_RESUME" >&2
            echo "Training will not fall back to the Stage 5 baseline." >&2
            exit 2
        fi
        args+=(--resume "$STAGE6_RESUME")
    elif [[ -n "${STAGE6_RESUME:-}" ]]; then
        args+=(--resume "$STAGE6_RESUME")
    else
        args+=(--init-from "${STAGE6_INITIAL_CHECKPOINT:-stage_6_tinystories/baseline/stage5_best.pt}")
    fi
    if [[ "$STAGE6_MODE" == preflight ]]; then args+=(--verify-shards); fi
    # Resume to the cumulative +25M review gate without changing the 100M LR schedule.
    # Explicitly set STAGE6_STOP_AFTER=0 to continue to the full configured budget.
    if [[ "$STAGE6_MODE" == train ]]; then
        STAGE6_STOP_AFTER=${STAGE6_STOP_AFTER:-3052}
        if [[ "$STAGE6_STOP_AFTER" != 0 ]]; then args+=(--stop-after-updates "$STAGE6_STOP_AFTER"); fi
    fi
    python -u stage_6_tinystories/train.py "${args[@]}"
    if [[ "$STAGE6_MODE" == train && "$STAGE6_STOP_AFTER" != 0 ]] && \
       python -c "import json; s=json.load(open('${STAGE6_RUN_DIR}/summary.json')); raise SystemExit(0 if s.get('reason') == 'review_gate' and s.get('stage6_updates') == int('${STAGE6_STOP_AFTER}') else 1)"; then
        SAMPLE_DIR="stage_6_tinystories/evaluations/${STAGE6_RUN_NAME}_${PBS_JOBID}_u${STAGE6_STOP_AFTER}"
        echo "Generating fixed-prompt TinyStories samples at Stage 6 update ${STAGE6_STOP_AFTER}"
        python -u stage_6_tinystories/evaluate.py \
            --checkpoint "${STAGE6_RUN_DIR}/latest.pt" --config "$STAGE6_CONFIG" \
            --output-dir "$SAMPLE_DIR" --device cuda --cpu-threads 4 \
            --walltime-seconds 14400 --job-start-epoch "$STAGE6_JOB_START_EPOCH"
        python -c "import json; [print('SAMPLE prompt={0} seed={1}\nPROMPT: {2}\nCONTINUATION: {3}\n'.format(x['prompt_id'],x['seed'],x['prompt'],x['continuation'])) for x in map(json.loads,open('${SAMPLE_DIR}/stories.jsonl'))]"
    fi
fi
echo "Finished $(date)"
