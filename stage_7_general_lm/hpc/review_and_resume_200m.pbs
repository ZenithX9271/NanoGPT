#!/bin/bash
# User-approved 100M -> 200M continuation, unchanged training identity.
#PBS -N nanogpt_s7next
#PBS -P biometric-security.spons
#PBS -q standard
#PBS -l select=1:ncpus=2:ngpus=1:mem=16gb:centos=skylake
#PBS -l walltime=02:15:00
#PBS -j oe
set -euo pipefail
umask 077
: "${PBS_JOBID:?PBS allocation required}"
export STAGE7_START=$(date +%s)
export STAGE7_REPO=/home/cse/btech/cs1230342/zenithX9271/NanoGPT
export STAGE7_BASE=/scratch/cse/btech/cs1230342/nanogpt_stage7
export STAGE7_RUN="$STAGE7_BASE/train_2b_first100m_1141598"
export STAGE7_SOURCE="$STAGE7_REPO/stage_7_general_lm/reports/training_1141598"
export STAGE7_EVIDENCE="$STAGE7_REPO/stage_7_general_lm/reports/continuation_${PBS_JOBID%%.*}"
STAGE7_HELPER="$STAGE7_REPO/stage_7_general_lm/hpc/review_segment.py"
STAGE7_CHECKPOINT="$STAGE7_RUN/review_u6104_positions_100007936.pt"
STAGE7_CONFIG="$STAGE7_REPO/stage_7_general_lm/configs/production_2b_first100m.json"
STAGE7_MANIFEST="$STAGE7_BASE/packed_v1/manifest.json"
cd "$STAGE7_REPO"
exec 9>"$STAGE7_RUN/.continuation.lock"
flock -n 9 || { echo 'Another continuation owns this run'; exit 19; }
test -f "$STAGE7_SOURCE/mac_backup_verified.json"
mkdir "$STAGE7_EVIDENCE"
module purge
module load apps/pytorch/1.10.0/gpu/intelpython3.7
export PYTHONPATH="$STAGE7_REPO${PYTHONPATH:+:$PYTHONPATH}"
export CUBLAS_WORKSPACE_CONFIG=:4096:8 MKL_THREADING_LAYER=GNU
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 PYTHONUNBUFFERED=1

python -B - <<'PY'
import json, os
from pathlib import Path
from stage_7_general_lm.common import sha, source_identity
source=Path(os.environ['STAGE7_SOURCE'])
prior=json.loads((source/'allocation.json').read_text())
assert prior['exit_code']==0 and prior['allocation_seconds']+8100<=4*3600
backup=json.loads((source/'mac_backup_verified.json').read_text())
checkpoint=json.loads((source/'checkpoint.json').read_text())
assert backup['checkpoint_sha256']==checkpoint['checkpoint_sha256']
run=Path(os.environ['STAGE7_RUN'])
assert sha(run/'latest.pt')==checkpoint['checkpoint_sha256']
summary=json.loads((run/'summary.json').read_text())
assert summary['reason']=='review_gate' and summary['counters']['updates']==6104
launch=json.loads((source/'launch.json').read_text())
assert launch['code_identity']==source_identity()
with (Path(os.environ['STAGE7_EVIDENCE'])/'launch.json').open('x') as f:
    json.dump(dict(job_id=os.environ['PBS_JOBID'], source_checkpoint=checkpoint,
        prior_allocation_seconds=prior['allocation_seconds'], maximum_job_seconds=8100,
        cumulative_maximum_seconds=prior['allocation_seconds']+8100,
        authorization='User approved backup, expanded review and continuation to 200M on 2026-11-11',
        target_updates=12208,target_positions=200015872,code_identity=source_identity()),f,indent=2)
PY

record_exit() {
    local result=$?
    trap - EXIT
    STAGE7_EXIT="$result" python -B - <<'PY'
import json,os,time
from pathlib import Path
prior=json.loads((Path(os.environ['STAGE7_SOURCE'])/'allocation.json').read_text())
elapsed=time.time()-int(os.environ['STAGE7_START'])
record=dict(job_id=os.environ['PBS_JOBID'],exit_code=int(os.environ['STAGE7_EXIT']),
    allocation_seconds=elapsed,gpu_hours_upper_bound=elapsed/3600,
    cumulative_gpu_hours_upper_bound=(elapsed+prior['allocation_seconds'])/3600,
    automatic_continuation=False)
with (Path(os.environ['STAGE7_EVIDENCE'])/'allocation.json').open('x') as f: json.dump(record,f,indent=2)
print(json.dumps(record),flush=True)
PY
    exit "$result"
}
trap record_exit EXIT
echo "job_id=$PBS_JOBID host=$(hostname) run=$STAGE7_RUN"
python -B "$STAGE7_HELPER" review --checkpoint "$STAGE7_CHECKPOINT" \
    --checkpoint-record "$STAGE7_SOURCE/checkpoint.json" --config "$STAGE7_CONFIG" \
    --manifest "$STAGE7_MANIFEST" --metrics "$STAGE7_RUN/metrics.jsonl" \
    --probes "$STAGE7_SOURCE/completion_probes_v1.json" \
    --output "$STAGE7_EVIDENCE/review.json" --windows 512
(
    module purge
    module load compiler/python/3.9.13/ucs4/gnu/447
    unset PYTHONPATH
    "$STAGE7_BASE/prep_env_py39/bin/python" -B "$STAGE7_HELPER" decode \
        --tokenizer "$STAGE7_REPO/stage_7_general_lm/artifacts/native_tokenizer/tokenizer.json" \
        --input "$STAGE7_EVIDENCE/review.json" --output "$STAGE7_EVIDENCE/completions.json"
)
# The unchanged config allows up to 4h per process. Use its existing epoch
# argument to impose this allocation's earlier 02:15 deadline, including review.
STAGE7_BUDGET_EPOCH=$((STAGE7_START + 8100 - 14400))
echo 'RESUMING_100M_CHECKPOINT_TO_200M'
python -B -m stage_7_general_lm.train --mode train --device cuda --threads 2 \
    --config "$STAGE7_CONFIG" --manifest "$STAGE7_MANIFEST" --run-dir "$STAGE7_RUN" \
    --resume "$STAGE7_CHECKPOINT" --review-updates 12208 --job-start-epoch "$STAGE7_BUDGET_EPOCH"
python -B "$STAGE7_HELPER" finalize --run "$STAGE7_RUN" --output "$STAGE7_EVIDENCE"
