{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "source_id", "source_group", "split", "task", "passage", "question", "reference", "difficulty", "review_status"],
  "properties": {
    "case_id": {"type": "string"},
    "source_id": {"type": "string"},
    "source_group": {"type": "string"},
    "split": {"enum": ["dev", "test", "train"]},
    "task": {"enum": ["qa", "summary", "explanation", "missing_information", "state_tracking"]},
    "passage": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}}}},
    "question": {"type": "string"},
    "reference": {"type": "object", "required": ["answers", "unanswerable", "required_facts"], "properties": {"answers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "unanswerable": {"type": "boolean"}, "required_facts": {"type": "array"}}},
    "review_status": {"type": "string"}
  }
}
